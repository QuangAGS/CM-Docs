/// PATH       : prisma/fragment-member_residences.prisma
/// DATETIME   : 2026-09-08T11:22:00+07:00
/// VERSION    : 0.1.0-E-DRAFT
/// DESCRIPTION: Dán vào schema.prisma. Usage chỗ ở theo thời gian. Place = addresses.

enum member_residences_kind {
  ORIGIN
  RESIDENCE
  TEMPORARY
  LAST

  @@map("member_residences_kind")
}

model member_residences {
  id         String                   @id @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar(36)
  tenant_id  String                   @db.VarChar(36)
  member_id  String                   @db.VarChar(36)
  address_id String                   @db.VarChar(36)

  kind member_residences_kind @default(RESIDENCE)

  from_year  Int?
  from_month Int?
  from_day   Int?
  to_year    Int?
  to_month   Int?
  to_day     Int?
  is_lunar   Boolean @default(false)

  /// Tối đa một dòng true / member (app + partial unique). Đồng bộ members.current_address_id.
  is_current Boolean @default(false)

  note String? @db.VarChar(255)

  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  changed_by String?   @db.VarChar(36)
  deleted_at DateTime? @db.Timestamptz(6)

  members   members   @relation(fields: [member_id], references: [id], onUpdate: NoAction, map: "fk_residence_member")
  tenants   tenants   @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_residence_tenant")
  addresses addresses @relation(fields: [address_id], references: [id], onUpdate: NoAction, map: "fk_residence_address")
  users     users?    @relation(fields: [changed_by], references: [id], onUpdate: NoAction, map: "fk_residences_user")

  @@index([tenant_id], map: "idx_residence_tenant")
  @@index([member_id], map: "idx_residence_member")
  @@index([address_id], map: "idx_residence_address")
  @@index([tenant_id, member_id], map: "idx_residence_tenant_member")
  @@index([member_id, from_year], map: "idx_residence_member_from")
  @@index([changed_by], map: "idx_residences_user")
  @@index([deleted_at], map: "idx_residences_deleted_at")
  @@map("member_residences")
}
