<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="Draw.io">
  <diagram id="BPMN-Onboarding-Process" name="Onboarding Process">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- POOL -->
        <mxCell id="pool_onboarding" parent="1" style="swimlane;html=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;horizontalChildSize=0;stackLineWidth=1;collapsible=0;fontStyle=1;fontSize=14;fillColor=#1E293B;fontColor=#FFFFFF;strokeColor=#0F172A;" value="MyClan.com.vn - Tiến trình Thiết lập ban đầu &amp; Nhập dữ liệu (Onboarding Process)" vertex="1">
          <mxGeometry x="40" y="40" width="1520" height="780" as="geometry" />
        </mxCell>

        <!-- LANE 1: USER / CLAN ADMIN -->
        <mxCell id="lane_actor" parent="pool_onboarding" style="swimlane;html=1;startSize=30;horizontal=0;collapsible=0;fontStyle=1;fontSize=12;fillColor=#EFF6FF;strokeColor=#BFDBFE;fontColor=#1E3A8A;" value="Thành viên / Admin Dòng họ (Actor)" vertex="1">
          <mxGeometry x="30" y="0" width="1490" height="260" as="geometry" />
        </mxCell>
        <mxCell id="start_onboarding" parent="lane_actor" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#22C55E;fontColor=#FFFFFF;strokeColor=#15803D;fontStyle=1;" value="Start&#10;Onboarding" vertex="1">
          <mxGeometry x="40" y="105" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="gw_role_check" parent="lane_actor" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#CA8A04;fontStyle=1;fontSize=11;" value="Vai trò&#10;User?" vertex="1">
          <mxGeometry x="130" y="100" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- CLAN ADMIN BRANCH -->
        <mxCell id="task_config_clan" parent="lane_actor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontSize=11;" value="1. Cấu hình Dòng họ&#10;(Thông tin, Quy chế, Editor)" vertex="1">
          <mxGeometry x="250" y="30" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="task_activate_clan" parent="lane_actor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontSize=11;fontStyle=1;" value="2. Xác nhận Kích hoạt&#10;Mở cửa Dòng họ" vertex="1">
          <mxGeometry x="460" y="30" width="150" height="50" as="geometry" />
        </mxCell>

        <!-- MEMBER BRANCH -->
        <mxCell id="task_create_tree" parent="lane_actor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontSize=11;" value="1. Khởi tạo Phả đồ&#10;Nhánh 4 đời" vertex="1">
          <mxGeometry x="250" y="170" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="task_report_error" parent="lane_actor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontSize=11;" value="2. Khai báo / Phản hồi&#10;Sai lệch Thông tin" vertex="1">
          <mxGeometry x="460" y="170" width="150" height="50" as="geometry" />
        </mxCell>

        <mxCell id="end_onboarding_done" parent="lane_actor" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#22C55E;fontColor=#FFFFFF;strokeColor=#15803D;fontStyle=1;" value="Hoàn tất&#10;Onboarding" vertex="1">
          <mxGeometry x="1380" y="100" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- LANE 2: BACKEND / SERVICE -->
        <mxCell id="lane_system" parent="pool_onboarding" style="swimlane;html=1;startSize=30;horizontal=0;collapsible=0;fontStyle=1;fontSize=12;fillColor=#F8FAFC;strokeColor=#E2E8F0;fontColor=#334155;" value="Hệ thống MyClan Backend (Onboarding Service &amp; Policy Wrappers)" vertex="1">
          <mxGeometry x="30" y="260" width="1490" height="520" as="geometry" />
        </mxCell>

        <mxCell id="sys_correlation_first" parent="lane_system" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#64748B;fontSize=11;fontStyle=1;" value="Correlation FIRST Middleware:&#10;Gán Correlation ID" vertex="1">
          <mxGeometry x="120" y="30" width="160" height="50" as="geometry" />
        </mxCell>

        <mxCell id="gw_tenant_gate" parent="lane_system" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#CA8A04;fontStyle=1;fontSize=10;" value="[Tenant Gate]&#10;Tenant Status&#10;Hợp lệ?" vertex="1">
          <mxGeometry x="310" y="25" width="100" height="60" as="geometry" />
        </mxCell>

        <!-- ADMIN SERVICE ACTIONS -->
        <mxCell id="sys_save_clan_config" parent="lane_system" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#64748B;fontSize=11;" value="Lưu cấu hình Dòng họ&#10;&amp; Phân quyền Editor" vertex="1">
          <mxGeometry x="460" y="25" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sys_update_tenant_active" parent="lane_system" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=11;fontStyle=1;" value="Cập nhật TenantStatus&#10;= HOAT_DONG&#10;HTTP 200 OK" vertex="1">
          <mxGeometry x="660" y="25" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- MEMBER SERVICE ACTIONS -->
        <mxCell id="sys_assert_tree_limit" parent="lane_system" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#CA8A04;fontStyle=1;fontSize=10;" value="[Policy Assert]&#10;Giới hạn 4 đời&#10;&amp; Status CHINH_THUC?" vertex="1">
          <mxGeometry x="460" y="165" width="130" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sys_save_tree" parent="lane_system" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=11;" value="Tạo bản ghi Phả đồ&#10;&amp; Liên kết Thành viên&#10;HTTP 200 OK" vertex="1">
          <mxGeometry x="660" y="170" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sys_send_feedback" parent="lane_system" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#64748B;fontSize=11;" value="Tạo Notification Báo sai&#10;gửi tới Clan Admin/Editor" vertex="1">
          <mxGeometry x="660" y="270" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- ERROR NODES -->
        <mxCell id="err_403_tenant_inactive" parent="lane_system" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=10;" value="HTTP 403 Forbidden&#10;TENANT_NOT_ACTIVE /&#10;TENANT_SUSPENDED" vertex="1">
          <mxGeometry x="310" y="380" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="err_400_policy_failed" parent="lane_system" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=10;" value="HTTP 400 Bad Request&#10;EXCEED_4_GENERATIONS /&#10;MEMBER_NOT_CHINH_THUC" vertex="1">
          <mxGeometry x="490" y="380" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="sys_notice_page" parent="lane_system" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#EF4444;fontColor=#FFFFFF;strokeColor=#B91C1C;fontStyle=1;" value="Hiển thị lỗi&#10;Notice Page" vertex="1">
          <mxGeometry x="880" y="385" width="70" height="70" as="geometry" />
        </mxCell>

        <!-- FLOWS -->
        <mxCell id="f1" edge="1" parent="pool_onboarding" source="start_onboarding" target="sys_correlation_first" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;" />
        <mxCell id="f2" edge="1" parent="pool_onboarding" source="sys_correlation_first" target="gw_role_check" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;" />

        <!-- Role Branching -->
        <mxCell id="f_role_admin" edge="1" parent="pool_onboarding" source="gw_role_check" target="task_config_clan" value="CLAN_ADMIN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;fontSize=10;">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="55"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="f_role_member" edge="1" parent="pool_onboarding" source="gw_role_check" target="task_create_tree" value="USER / VIEWER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;fontSize=10;">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="195"/></Array></mxGeometry>
        </mxCell>

        <!-- Admin Flow -->
        <mxCell id="f_admin_submit_config" edge="1" parent="pool_onboarding" source="task_config_clan" target="gw_tenant_gate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;" />
        <mxCell id="f_gate_pass_admin" edge="1" parent="pool_onboarding" source="gw_tenant_gate" target="sys_save_clan_config" value="TAM_NGUNG (Onboarding)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16A34A;strokeWidth=2;fontSize=10;" />
        <mxCell id="f_admin_click_activate" edge="1" parent="pool_onboarding" source="sys_save_clan_config" target="task_activate_clan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;" />
        <mxCell id="f_admin_submit_activate" edge="1" parent="pool_onboarding" source="task_activate_clan" target="sys_update_tenant_active" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;" />
        <mxCell id="f_activate_done" edge="1" parent="pool_onboarding" source="sys_update_tenant_active" target="end_onboarding_done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16A34A;strokeWidth=2;" />

        <!-- Member Flow -->
        <mxCell id="f_member_submit_tree" edge="1" parent="pool_onboarding" source="task_create_tree" target="sys_assert_tree_limit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;" />
        <mxCell id="f_assert_tree_pass" edge="1" parent="pool_onboarding" source="sys_assert_tree_limit" target="sys_save_tree" value="Hợp lệ (&lt;= 4 đời)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16A34A;strokeWidth=2;fontSize=10;" />
        <mxCell id="f_tree_done" edge="1" parent="pool_onboarding" source="sys_save_tree" target="end_onboarding_done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16A34A;strokeWidth=2;" />

        <mxCell id="f_member_report" edge="1" parent="pool_onboarding" source="task_report_error" target="sys_send_feedback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;" />
        <mxCell id="f_report_done" edge="1" parent="pool_onboarding" source="sys_send_feedback" target="end_onboarding_done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16A34A;strokeWidth=2;" />

        <!-- Tenant Gate & Error Flows -->
        <mxCell id="f_gate_fail" edge="1" parent="pool_onboarding" source="gw_tenant_gate" target="err_403_tenant_inactive" value="Không hợp lệ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#DC2626;fontSize=10;" />
        <mxCell id="f_assert_tree_fail" edge="1" parent="pool_onboarding" source="sys_assert_tree_limit" target="err_400_policy_failed" value="Vi phạm Policy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#DC2626;fontSize=10;" />

        <mxCell id="f_e1" edge="1" parent="pool_onboarding" source="err_403_tenant_inactive" target="sys_notice_page" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#DC2626;" />
        <mxCell id="f_e2" edge="1" parent="pool_onboarding" source="err_400_policy_failed" target="sys_notice_page" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#DC2626;" />

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>